{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/contact-form",
  "version": "1.0.0",
  "title": "Contact form",
  "category": "doclap",
  "icon": "email",
  "description": "Editable contact page with secure email delivery.",
  "keywords": [ "contact", "form", "email", "message", "recaptcha" ],
  "textdomain": "doclap",
  "attributes": {
    "sectionBg": { "type": "string", "default": "" },
    "sectionHeading": { "type": "string", "default": "" },
    "sectionText": { "type": "string", "default": "" },
    "asideMeta": { "type": "string", "default": "A CONVERSATION, NO PRESSURE." },
    "asideHeading": { "type": "string", "default": "Not yet<br>the perfect brief." },
    "asideCopy": {
      "type": "string",
      "default": "Share your goals, the things you are unsure about and what you want to change. We will make the rest clear together."
    },
    "asideSteps": {
      "type": "array",
      "default": [ "01 — Listen to context", "02 — Define the scope", "03 — Align the way we work" ]
    },
    "asideLinkLabel": { "type": "string", "default": "Before we start" },
    "asideLinkUrl": { "type": "string", "default": "/faq/" },
    "nameLabel": { "type": "string", "default": "Your name *" },
    "emailLabel": { "type": "string", "default": "Contact email *" },
    "companyLabel": { "type": "string", "default": "Brand / organisation" },
    "servicesLabel": { "type": "string", "default": "What do you need?" },
    "services": {
      "type": "array",
      "default": [
        { "value": "Web design", "label": "Web design" },
        { "value": "Motion & interaction", "label": "Motion & interaction" },
        { "value": "Creative development", "label": "Creative development" },
        { "value": "Explore together", "label": "Explore together" }
      ]
    },
    "messageLabel": { "type": "string", "default": "Tell us a little about your idea *" },
    "messagePlaceholder": { "type": "string", "default": "Goals, context, expected timeline…" },
    "consentLabel": { "type": "string", "default": "I agree that my details may be used to respond to this enquiry." },
    "buttonLabel": { "type": "string", "default": "Send your message" },
    "sendingLabel": { "type": "string", "default": "Sending…" },
    "successMessage": { "type": "string", "default": "Thank you. Your message has been sent." },
    "errorMessage": { "type": "string", "default": "Something went wrong. Please try again." },
    "formNote": { "type": "string", "default": "Required fields are marked with an asterisk." }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
