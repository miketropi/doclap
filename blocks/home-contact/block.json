{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/home-contact",
  "version": "1.0.0",
  "title": "Home — Contact",
  "category": "doclap",
  "icon": "email",
  "description": "Closing contact band with heading, lead and call to action.",
  "keywords": [ "home", "contact", "cta", "invitation" ],
  "textdomain": "doclap",
  "attributes": {
    "sectionBg": { "type": "string", "default": "" },
    "sectionHeading": { "type": "string", "default": "" },
    "sectionText": { "type": "string", "default": "" },
    "contactEyebrow": { "type": "string", "default": "03 / A NEW BEGINNING" },
    "contactHeading": {
      "type": "string",
      "default": "Your idea.<br><em>Make it different.</em>"
    },
    "contactHeadingAccent": { "type": "string", "default": "" },
    "contactLead": {
      "type": "string",
      "default": "A new website, a bold experience, or simply an interesting conversation."
    },
    "contactCtaLabel": { "type": "string", "default": "Write a greeting" },
    "contactCtaUrl": { "type": "string", "default": "/contact/" }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
