    "heroEdition": { "type": "string", "default": "CREATIVE PROFILE / 2026" },
    "heroPanels": {
      "type": "array",
      "default": [
        {
          "eyebrow": "01 / EMOTION COMES FIRST",
          "heading": "Not just to look.<br><em>Feel it.</em>",
          "lead": "I turn ideas into digital experiences.<br>Where design has a soul. And technology knows how to touch.",
          "linkLabel": "Explore the work",
          "linkUrl": "#work"
        },
        {
          "eyebrow": "02 / MOTION IS A LANGUAGE",
          "heading": "Still in form.<br><em>Moving in spirit.</em>",
          "lead": "Another view. A new rhythm.<br>Every movement has a reason.",
          "linkLabel": "Into the design thinking",
          "linkUrl": "#about"
        }
      ]
    },
    "posterId": { "type": "number", "default": 0 },
    "posterUrl": { "type": "string", "default": "" },
