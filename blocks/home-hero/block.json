    "creditText": {
      "type": "string",
      "default": "David, Michelangelo · SMK cast sculpture scan (CC0) · Optimised model:"
    },
    "creditUrl": {
      "type": "string",
      "default": "https://sketchfab.com/3d-models/head-of-michelangelos-david-optimised-d29af50360624e5e9b1855666475380d"
    }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
