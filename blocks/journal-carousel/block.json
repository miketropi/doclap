{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/journal-carousel",
  "version": "1.0.0",
  "title": "Journal carousel",
  "category": "doclap",
  "icon": "list-view",
  "description": "The newest published notes in a scroll-snap carousel with a counter and step buttons.",
  "keywords": [ "journal", "posts", "latest", "carousel", "articles" ],
  "textdomain": "doclap",
  "attributes": {
    "sectionBg": { "type": "string", "default": "" },
    "sectionHeading": { "type": "string", "default": "" },
    "sectionText": { "type": "string", "default": "" },
    "journalEyebrow": { "type": "string", "default": "05 / FROM THE JOURNAL" },
    "journalHeading": { "type": "string", "default": "A little distance.<br>A different perspective." },
    "journalHeadingAccent": { "type": "string", "default": "" },
    "postsPerPage": { "type": "number", "default": 3 },
    "categories": { "type": "array", "default": [] },
    "tags": { "type": "array", "default": [] },
    "viewAllLabel": { "type": "string", "default": "" },
    "viewAllUrl": { "type": "string", "default": "@notes" },
    "ariaLabel": { "type": "string", "default": "Journal carousel" },
    "artLabel": { "type": "string", "default": "ĐỘC LẬP / NOTES" },
    "readMoreLabel": { "type": "string", "default": "Read the perspective" },
    "emptyLabel": { "type": "string", "default": "No notes published yet." },
    "cardMeta": { "type": "string", "default": "STUDIO NOTES" }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
