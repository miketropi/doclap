{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/not-found",
  "version": "1.0.0",
  "title": "Not Found",
  "category": "doclap",
  "icon": "warning",
  "description": "Editable 404 recovery page.",
  "textdomain": "doclap",
  "attributes": {
    "errorCode": { "type": "string", "default": "404" },
    "eyebrow": { "type": "string", "default": "SLIGHTLY OFF COURSE" },
    "heading": { "type": "string", "default": "A blank space." },
    "headingAccent": { "type": "string", "default": "Not the end point." },
    "lead": { "type": "string", "default": "This page does not exist or has moved.\nBut there is still much worth exploring." },
    "primaryLabel": { "type": "string", "default": "Back to home" },
    "primaryUrl": { "type": "string", "default": "" },
    "secondaryLabel": { "type": "string", "default": "Find another direction" },
    "secondaryUrl": { "type": "string", "default": "@search" },
    "asideLabel": { "type": "string", "default": "KEEP WANDERING" },
    "asideHeading": { "type": "string", "default": "Change direction." },
    "asideHeadingAccent": { "type": "string", "default": "Stay curious." },
    "links": {
      "type": "array",
      "default": [
        { "label": "Explore the work", "url": "#work" },
        { "label": "Meet độc lập", "url": "/about-us/" },
        { "label": "Read a note", "url": "@notes" },
        { "label": "Start a conversation", "url": "/contact/" }
      ]
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
