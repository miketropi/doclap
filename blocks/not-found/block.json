{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/not-found",
  "version": "1.0.0",
  "title": "Not found",
  "category": "doclap",
  "icon": "warning",
  "description": "Editable 404 recovery page.",
  "keywords": [ "404", "error", "recovery", "search" ],
  "textdomain": "doclap",
  "attributes": {
    "errorCode": { "type": "string", "default": "404" },
    "eyebrow": { "type": "string", "default": "SLIGHTLY OFF COURSE" },
    "heading": {
      "type": "string",
      "default": "A blank space.<br><em>Not the end point.</em>"
    },
    "headingAccent": { "type": "string", "default": "" },
    "lead": {
      "type": "string",
      "default": "This page does not exist or has moved.<br>But there is still much worth exploring."
    },
    "primaryLabel": { "type": "string", "default": "Back to home" },
    "primaryUrl": { "type": "string", "default": "" },
    "secondaryLabel": { "type": "string", "default": "Find another direction" },
    "secondaryUrl": { "type": "string", "default": "@search" },
    "asideLabel": { "type": "string", "default": "KEEP WANDERING" },
    "asideHeading": {
      "type": "string",
      "default": "Change direction.<br>Stay curious."
    },
    "asideHeadingAccent": { "type": "string", "default": "" },
    "links": {
      "type": "array",
      "default": [
        { "label": "Explore the work", "url": "#work" },
        { "label": "Meet độc lập", "url": "/about-us/" },
        { "label": "Read a note", "url": "@notes" },
        { "label": "Start a conversation", "url": "/contact/" }
      ]
    }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
