{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/notes-archive",
  "version": "1.0.0",
  "title": "Doclap notes archive",
  "category": "doclap",
  "icon": "excerpt-view",
  "description": "Query-driven editorial notes archive with featured post, categories and pagination.",
  "keywords": [ "notes", "archive", "journal" ],
  "textdomain": "doclap",
  "attributes": {
    "sectionBg": { "type": "string", "default": "" },
    "sectionHeading": { "type": "string", "default": "" },
    "sectionText": { "type": "string", "default": "" },
    "showFeatured": { "type": "boolean", "default": true },
    "postsPerPage": { "type": "integer", "default": 6 },
    "showCategories": { "type": "boolean", "default": true },
    "headingSectionTitle": { "type": "string", "default": "From the desk." },
    "countSingular": { "type": "string", "default": "%d note" },
    "countPlural": { "type": "string", "default": "%d notes" },
    "emptyHeading": { "type": "string", "default": "No notes yet." },
    "emptyCopy": { "type": "string", "default": "New editorial notes will appear here when they are published." },
    "disclaimer": {
      "type": "string",
      "default": "The articles are editorial notes from the portfolio, not client case studies."
    }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
