{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/page-content",
  "version": "1.0.0",
  "title": "Page content",
  "category": "doclap",
  "icon": "page",
  "description": "The queried page's own blocks, rendered inside the theme's container and prose measure.",
  "keywords": [ "page", "content", "body" ],
  "textdomain": "doclap",
  "attributes": {
    "sectionBg": { "type": "string", "default": "" },
    "sectionHeading": { "type": "string", "default": "" },
    "sectionText": { "type": "string", "default": "" }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
