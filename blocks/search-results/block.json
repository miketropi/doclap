{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/search-results",
  "version": "1.0.0",
  "title": "Search results",
  "category": "doclap",
  "icon": "search",
  "description": "A native WordPress search form, filters, and results.",
  "keywords": [ "search", "results", "filter", "query" ],
  "textdomain": "doclap",
  "attributes": {
    "breadcrumbHomeLabel": { "type": "string", "default": "Home" },
    "breadcrumbLabel": { "type": "string", "default": "Search" },
    "heading": {
      "type": "string",
      "default": "Something<br><em>waiting to be seen.</em>"
    },
    "headingAccent": { "type": "string", "default": "" },
    "lead": { "type": "string", "default": "Search across the pages, notes and studies of độc lập." },
    "searchPlaceholder": { "type": "string", "default": "What are you looking for?" },
    "searchLabel": { "type": "string", "default": "Search content" },
    "submitLabel": { "type": "string", "default": "Search" },
    "helpNote": { "type": "string", "default": "Try: motion, typography, process, contact." },
    "filterAllLabel": { "type": "string", "default": "All" },
    "filterPageLabel": { "type": "string", "default": "Pages" },
    "filterNoteLabel": { "type": "string", "default": "Notes" },
    "filterWorkLabel": { "type": "string", "default": "Work" },
    "resultSingular": { "type": "string", "default": "%d result" },
    "resultPlural": { "type": "string", "default": "%d results" },
    "noResultsHeading": { "type": "string", "default": "We could not find what you need." },
    "noResultsCopy": {
      "type": "string",
      "default": "Try a shorter word, remove diacritics or switch to the “All” group."
    },
    "noResultsLinkLabel": { "type": "string", "default": "Explore notes" },
    "noResultsLinkUrl": { "type": "string", "default": "@notes" },
    "emptyHeading": { "type": "string", "default": "What are you looking for?" },
    "emptyCopy": { "type": "string", "default": "Enter a word or phrase to search the site." }
  },
  "supports": { "html": false, "anchor": true },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
