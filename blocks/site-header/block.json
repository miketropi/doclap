						},
						{
							"label": "Type Orbits",
							"description": "When type leaves the plane\nand steps into the space.",
							"url": "#experiment-orbit",
							"indexLabel": "STUDY / 002",
							"footLabel": "Kinetic typography"
						}
					]
				},
				{
					"label": "Perspectives",
					"panelLayout": "list",
					"panelLabel": "THINKING / PEOPLE",
