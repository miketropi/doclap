{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "doclap/site-header",
  "version": "1.0.0",
  "title": "Doclap site header",
  "category": "doclap",
  "icon": "menu-alt",
  "description": "Sticky editorial header that renders a WordPress menu, with a compact menu control.",
  "keywords": [ "header", "navigation", "menu", "doclap" ],
  "textdomain": "doclap",
  "attributes": {
    "brandText": { "type": "string", "default": "độc lập" },
    "brandSuffix": { "type": "string", "default": "®" },
    "brandMode": { "type": "string", "default": "text" },
    "brandMediaId": { "type": "number", "default": 0 },
    "brandMediaUrl": { "type": "string", "default": "" },
    "brandMediaAlt": { "type": "string", "default": "" },
    "brandUrl": { "type": "string", "default": "" },
    "skipLabel": { "type": "string", "default": "Skip to content" },
    "navLabel": { "type": "string", "default": "Main navigation" },
    "menuLabel": { "type": "string", "default": "Menu" },
    "menuCloseLabel": { "type": "string", "default": "Close" },
    "ctaLabel": { "type": "string", "default": "Start a conversation" },
    "ctaUrl": { "type": "string", "default": "#contact" },
    "showProgress": { "type": "boolean", "default": true },
    "menuId": { "type": "number", "default": 0 },
    "menuDepth": { "type": "number", "default": 4 }
  },
  "supports": { "html": false, "anchor": true, "reusable": false },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
