{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "doclap/site-header",
	"title": "Doclap site header",
	"category": "doclap",
	"description": "Sticky editorial header with disclosure panels, quick links and a compact menu control.",
	"keywords": ["header", "navigation", "menu", "doclap"],
	"textdomain": "doclap",
	"icon": "menu-alt",
	"supports": {
		"html": false,
		"align": false,
		"anchor": true,
		"reusable": false
